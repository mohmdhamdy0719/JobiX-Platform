modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["android-tools", "flutter", "freetype", "jdk17", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "postgresql", "sdkmanager", "sqlcipher", "tcl", "tk", "zlib"]

[userenv]

[userenv.shared]
JOBIX_ANDROID_APPLICATION_ID = "com.mhflow.jobix"
JOBIX_IOS_BUNDLE_ID = "com.mhflow.jobix"
JOBIX_ANDROID_MIN_SDK = "24"
JOBIX_ANDROID_TARGET_SDK = "36"
JOBIX_IOS_DEPLOYMENT_TARGET = "13.0"
JOBIX_APP_VERSION = "1.0.0"
JOBIX_DEV_SUPABASE_URL = "https://lmouxhbjhtqdtiqijcee.supabase.co"
JOBIX_DEV_SUPABASE_CLIENT_KEY = "sb_publishable_QXujyEqNvdIJAoSQvmKcsg_l3gQn4be"
JOBIX_STAGING_SUPABASE_URL = "NOT_CONFIGURED"
JOBIX_STAGING_SUPABASE_CLIENT_KEY = "NOT_CONFIGURED"
JOBIX_PROD_SUPABASE_URL = "NOT_CONFIGURED"
JOBIX_PROD_SUPABASE_CLIENT_KEY = "NOT_CONFIGURED"
ANDROID_HOME = "/home/runner/workspace/.local/toolchains/android-sdk"
ANDROID_SDK_ROOT = "/home/runner/workspace/.local/toolchains/android-sdk"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081
